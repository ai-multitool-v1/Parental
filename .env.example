# ============================================================
# Parental Control Platform — Website environment template
# এই ফাইলটি কপি করে .env.local বানান (Vercel-এ হলে Dashboard →
# Settings → Environment Variables-এ দিন)।
# মানগুলো পাবেন: Firebase console → Project settings → General →
# Your apps → Web app → SDK setup and configuration
# ============================================================

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Optional: Developer Admin Console (/admin) -------------
# ডিফল্ট bootstrap password server console-এ একবার print হয়।
# Vercel-এ অবশ্যই নিচের env দুটি দিন (README দেখুন):
ADMIN_USERNAME=admin
# ফরম্যাট: 16384$8$1$<saltB64>$<hashB64>  — generator কমান্ড README-তে
ADMIN_PASSWORD_HASH=

# --- Optional: server-side store directory ------------------
# ডিফল্ট: <project>/.server (Vercel-এ auto /tmp fallback)
# AUTH_STORE_DIR=
