<?xml version="1.0" encoding="utf-8"?>
<!-- Parent-initiated permission REQUEST screen (REQUEST_PERMISSION command).
     The parent can only ASK — the actual grant always happens through the
     visible Android system dialog / settings screen. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/perm_request_title"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/perm_request_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="16sp"
            android:lineSpacingMultiplier="1.2" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/perm_request_note"
            android:textSize="13sp" />

        <Button
            android:id="@+id/perm_request_allow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/perm_request_allow" />

        <Button
            android:id="@+id/perm_request_later"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/perm_request_later" />

    </LinearLayout>
</ScrollView>
